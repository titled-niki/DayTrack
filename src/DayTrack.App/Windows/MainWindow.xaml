<Window x:Class="DayTrack.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="900" Height="620" Title="DayTrack"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DayTrack" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><Button x:Name="SettingsButton" Grid.Column="1" Click="Settings_Click"/></Grid>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10"><Button x:Name="TodayButton" Click="Today_Click"/><Button x:Name="WeekButton" Click="Week_Click"/><Button x:Name="MonthButton" Click="Month_Click"/><Button x:Name="AllButton" Click="All_Click"/></StackPanel>
 <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,14"><Border Background="{DynamicResource PanelBrush}" Padding="12" Margin="3"><StackPanel><TextBlock x:Name="ActiveLabel"/><TextBlock x:Name="ActiveValue" FontSize="19"/></StackPanel></Border><Border Background="{DynamicResource PanelBrush}" Padding="12" Margin="3"><StackPanel><TextBlock x:Name="AfkLabel"/><TextBlock x:Name="AfkValue" FontSize="19"/></StackPanel></Border><Border Background="{DynamicResource PanelBrush}" Padding="12" Margin="3"><StackPanel><TextBlock x:Name="PcOnLabel"/><TextBlock x:Name="PcOnValue" FontSize="19"/></StackPanel></Border><Border Background="{DynamicResource PanelBrush}" Padding="12" Margin="3"><StackPanel><TextBlock x:Name="KeysLabel"/><TextBlock x:Name="KeysValue" FontSize="19"/></StackPanel></Border><Border Background="{DynamicResource PanelBrush}" Padding="12" Margin="3"><StackPanel><TextBlock x:Name="TrafficLabel"/><TextBlock x:Name="TrafficValue" FontSize="19"/></StackPanel></Border></UniformGrid>
 <DataGrid x:Name="AppsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn x:Name="AppColumn" Binding="{Binding AppName}" Width="*"/><DataGridTextColumn x:Name="TimeColumn" Binding="{Binding DisplayTime}" Width="180"/><DataGridTextColumn x:Name="LaunchesColumn" Binding="{Binding Launches}" Width="120"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="OpenHistoryButton" Click="History_Click"/><Button Content="TXT" Click="Txt_Click"/><Button Content="CSV" Click="Csv_Click"/><Button Content="JSON" Click="Json_Click"/></StackPanel>
 </Grid></Window>
