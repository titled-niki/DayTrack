<Window x:Class="DayTrack.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="920"
        MinWidth="700" MinHeight="920"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        Title="DayTrack"
        Icon="/Assets/day_tracker_icon_256.png">
    <Grid Background="{DynamicResource BgBrush}">
        <Border Margin="18" Padding="26"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="48" Height="48" Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="11" Margin="0,0,13,0">
                                <Image Source="/Assets/day_tracker_icon_256.png" Stretch="Uniform" Margin="7"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DayTrack" FontSize="31" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TaglineText" FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="1,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="IntroText" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="0,0,0,22"/>

                        <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,18">
                            <ComboBoxItem Tag="system"/><ComboBoxItem Tag="en"/><ComboBoxItem Tag="ru"/>
                            <ComboBoxItem Tag="uk"/><ComboBoxItem Tag="ja"/><ComboBoxItem Tag="zh"/>
                        </ComboBox>

                        <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <ComboBox x:Name="ThemeCombo" Margin="0,0,0,18">
                            <ComboBoxItem Tag="system"/><ComboBoxItem Tag="light"/><ComboBoxItem Tag="dark"/>
                        </ComboBox>

                        <TextBlock x:Name="ExportFolderLabel" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExportFolderText" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseFolderButton" Grid.Column="1" MinWidth="120" Margin="8,0,0,0"
                                    Click="BrowseFolder_Click"/>
                        </Grid>
                        <TextBlock x:Name="ExportFolderHint" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,18"/>

                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,3,0,18">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheck"/>
                                <CheckBox x:Name="DesktopShortcutCheck"/>
                                <CheckBox x:Name="LaunchAfterSetupCheck"/>
                                <CheckBox x:Name="KeysCheck"/>
                                <CheckBox x:Name="ClicksCheck"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" MinHeight="72" Margin="0,0,0,6">
                            <TextBlock x:Name="PrivacyNote" Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" TextTrimming="None" FontSize="12.5" LineHeight="19"
                                       VerticalAlignment="Center"/>
                        </Border>
                </StackPanel>

                <Button x:Name="FinishButton" Grid.Row="1" Height="46" FontSize="14"
                        Margin="0,18,0,0" Click="Finish_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
